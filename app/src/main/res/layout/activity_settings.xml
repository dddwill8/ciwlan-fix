<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/safety_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/banner_bg"
            android:padding="12dp"
            android:text="@string/safety_banner"
            android:textColor="@color/danger"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/fn1_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fn1_summary"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/fn1_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="force_oos_slot1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fn1_plmn" />

        <EditText
            android:id="@+id/fn1_plmn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="99999"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/fn2_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fn2_summary"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/fn2_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="set_ciwlan_only_slot1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/fn3_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fn3_summary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/fn3_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/fn3_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fn3_auto" />

            <RadioButton
                android:id="@+id/fn3_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fn3_on" />

            <RadioButton
                android:id="@+id/fn3_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fn3_off" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/status_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runtime_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/status_empty"
            android:textSize="12sp" />

        <Button
            android:id="@+id/refresh_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/refresh_status" />

        <Button
            android:id="@+id/restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/restore" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/restore_hint"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/logcat_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/grant_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
